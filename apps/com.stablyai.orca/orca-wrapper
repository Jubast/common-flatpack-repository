#!/bin/sh
set -eu

# Orca is an Electron app staged by apply_extra to /app/extra/Orca. Run it
# through zypak-wrapper from org.electronjs.Electron2.BaseApp so Chromium keeps
# its internal sandbox inside Flatpak.

# A leaked ELECTRON_RUN_AS_NODE would start the GUI and zypak children as plain Node.
unset ELECTRON_RUN_AS_NODE

# Links ~/.config/orca to the persisted $XDG_CONFIG_HOME/orca, where docs and skills
# point; the sandbox home outside ~/.var is reset each start.
mkdir -p "$HOME/.config" "$XDG_CONFIG_HOME/orca"
link="$HOME/.config/orca"
[ -e "$link" ] || [ -L "$link" ] || ln -s "$XDG_CONFIG_HOME/orca" "$link"

exec zypak-wrapper /app/extra/Orca/orca-ide --ozone-platform-hint=auto "$@"
