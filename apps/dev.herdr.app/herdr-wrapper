#!/bin/sh
set -eu

# Same config dir and control socket as host-side `herdr-app` callers.
export HERDR_APP_HOME="${HOST_XDG_CONFIG_HOME:-$HOME/.config}/herdr-app"
# A path the host sees too, for sound files a host player may open.
export TMPDIR="$XDG_RUNTIME_DIR/app/$FLATPAK_ID"
host_bin="$(/app/lib/host-bridge/setup-host-bin || true)"
PATH="/app/lib/herdr-app/core:/app/bin:$PATH"
if [ -n "$host_bin" ] && [ -d "$host_bin" ]; then PATH="$PATH:$host_bin"; fi
export PATH
exec /app/lib/herdr-app/herdr-app "$@"
